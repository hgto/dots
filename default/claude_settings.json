{
  "env": {
    "CLAUDE_CODE_DISABLE_TERMINAL_TITLE": "1"
  },
  "permissions": {
    "defaultMode": "auto"
  },
  "model": "sonnet[1m]",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/Projects/dots/default/git-guard/block-commit-on-main.sh"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/Projects/dots/default/git-guard/block-edit-on-main.sh"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "swift-lsp@claude-plugins-official": true,
    "aws-core@claude-plugins-official": true,
    "slack@claude-plugins-official": true,
    "terraform@claude-plugins-official": true,
    "security-skills@hgto": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "chrome-devtools-mcp@claude-plugins-official": true,
    "systems-programming@claude-code-workflows": true,
    "auth0@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "hgto": {
      "source": {
        "source": "github",
        "repo": "hgto/security-skills"
      }
    }
  },
  "skipDangerousModePermissionPrompt": true,
  "theme": "auto",
  "editorMode": "vim",
  "agentPushNotifEnabled": true
}
