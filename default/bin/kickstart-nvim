#!/bin/sh
# kickstart-nvim: run nvim-lua/kickstart.nvim isolated via NVIM_APPNAME.
# Config, data, state and cache all live under a "kickstart-nvim" namespace,
# so this never touches your normal ~/.config/nvim. Bootstraps the config on
# first run; the clone's .git is removed so it stays out of git entirely.
set -e
cfg="${XDG_CONFIG_HOME:-$HOME/.config}/kickstart-nvim"
if [ ! -d "$cfg" ]; then
  git clone --depth 1 https://github.com/nvim-lua/kickstart.nvim "$cfg"
  rm -rf "$cfg/.git"
fi
exec env NVIM_APPNAME=kickstart-nvim nvim "$@"
