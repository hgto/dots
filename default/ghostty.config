shell-integration = detect
theme = dark:Catppuccin Frappe,light:Catppuccin Latte
#
# === Font ===
font-family = JetBrainsMonoNL Nerd Font
font-size = 15
# subtle weight bump, better on Retina
font-thicken = true
# extra line spacing — easier on the eyes
adjust-cell-height = 10%

# === Theme: auto-switch with macOS appearance ===
# Light by default; soft dark when you flip macOS to dark mode
theme = light:Catppuccin Latte,dark:rose-pine-moon
window-theme = auto

# Floor contrast so no theme color becomes unreadable
minimum-contrast = 1.15

# === Window ===
macos-titlebar-style = tabs
window-padding-x = 12
window-padding-y = 10
# restore tabs/splits across restarts
window-save-state = always
# keep 1.0 for max readability
background-opacity = 1.0
mouse-hide-while-typing = true

# === Cursor ===
cursor-style = block
cursor-style-blink = false

# === Scrollback (Claude Code produces a LOT) ===
scrollback-limit = 100000000

# === Splits — handy for Claude Code in one pane, shell in another ===
keybind = cmd+d=new_split:right
keybind = cmd+shift+d=new_split:down
keybind = cmd+[=goto_split:previous
keybind = cmd+]=goto_split:next

# === Shell integration (improves Claude Code's prompt detection) ===
shell-integration = detect
shell-integration-features = cursor,sudo,title

#
# Tmux-like leader sequences using your C-a prefix.
keybind = ctrl+a>ctrl+a=text:\x01
keybind = ctrl+a>c=new_tab
keybind = ctrl+a>C=new_window
keybind = ctrl+a>v=new_split:right
keybind = ctrl+a>s=new_split:down
keybind = ctrl+a>n=next_tab
keybind = ctrl+a>m=previous_tab
keybind = ctrl+a>h=goto_split:right
keybind = ctrl+a>j=goto_split:down
keybind = ctrl+a>k=goto_split:up
keybind = ctrl+a>l=goto_split:left
keybind = ctrl+a>o=goto_split:next
keybind = ctrl+a>z=toggle_split_zoom
keybind = ctrl+a>[=previous_tab
keybind = ctrl+a>]=next_tab
keybind = ctrl+a>r=reload_config
keybind = ctrl+a>w=close_surface
